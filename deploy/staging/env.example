# Copy to /home/ecity/app/.env on the server and fill in the two secrets.
# Never commit the real file.

NODE_ENV=production

# Must match POSTGRES_PASSWORD below. "db" is the container name, not a host.
DATABASE_URL=postgres://ecity:REPLACE_WITH_DB_PASSWORD@db:5432/ecity
POSTGRES_PASSWORD=REPLACE_WITH_DB_PASSWORD

# Generate with:  openssl rand -base64 32
AUTH_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING

# The public URL, used in links. Match your Caddyfile exactly.
AUTH_URL=https://SERVER_IP.sslip.io

# Staging can be chatty; production should be 'info'.
LOG_LEVEL=debug

# Files on the server's own disk for now. Cloudflare R2 comes at go-live.
STORAGE_DRIVER=local

# The seeded demo accounts' password. Change it, and never reuse it anywhere.
SEED_PASSWORD=REPLACE_WITH_A_STAGING_PASSWORD
