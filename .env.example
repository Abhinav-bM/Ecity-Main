# Copy to .env and fill in. NEVER commit .env.
# Generate secrets with: openssl rand -base64 32

DATABASE_URL=postgres://ecity:ecity@localhost:5432/ecity
AUTH_SECRET=replace-me-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# Session policy
SESSION_IDLE_MINUTES=720
SESSION_ABSOLUTE_HOURS=336

LOG_LEVEL=info

# Seed only. Remove before production.
SEED_PASSWORD=ChangeMe!2026
