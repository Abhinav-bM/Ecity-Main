# Copy to .env and fill in. NEVER commit .env.
# Generate secrets with: openssl rand -base64 32

# ── Required everywhere ──────────────────────────────────────────────────
DATABASE_URL=postgres://ecity:ecity@localhost:5432/ecity
AUTH_SECRET=replace-me-with-openssl-rand-base64-32

# The address the app is served on. In production the session cookie is
# Secure, so this must be https — over plain http the login page appears and
# then silently refuses to sign anyone in.
AUTH_URL=http://localhost:3000

# ── On a server ──────────────────────────────────────────────────────────
# NODE_ENV=production
# The database container reads this; it must match the password in
# DATABASE_URL above.
# POSTGRES_PASSWORD=

# ── Session policy (optional; these are the defaults) ────────────────────
SESSION_IDLE_MINUTES=720
SESSION_ABSOLUTE_HOURS=336
LOG_LEVEL=info

# ── Branding. Swap the whole colour scheme without touching code. ────────
# One of: onyx (black, default) | navy | emerald | amber
# Add new ones in src/app/globals.css + src/lib/theme.ts.
APP_THEME=onyx
# light | dark | system
APP_COLOR_SCHEME=system

# ── Uploads: bill photos, supplier invoices, product images ──────────────
# local = .storage/ on disk. Fine on a laptop; on a server the container is
# replaced by every deploy and takes the files with it.
# s3    = any S3-protocol bucket. "S3" is the protocol, not Amazon —
#         Cloudflare R2 speaks it, and is what this shop uses.
STORAGE_DRIVER=local

# Needed only when STORAGE_DRIVER=s3. With the driver set to s3 and any of
# these missing, the first upload fails naming the one that is absent — it
# never quietly falls back to the disk.
# R2_ACCOUNT_ID=
# S3_BUCKET=ecity-uploads
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Only if you move off R2 (Backblaze, MinIO). Replaces R2_ACCOUNT_ID.
# S3_ENDPOINT=

# ── Off-site backups (read by scripts/backup.sh, not by the app) ─────────
# The same R2 token as above. RESTIC_PASSWORD encrypts the backup repository:
# store it somewhere that is NOT this server. If the server dies and this key
# died with it, the backups are unreadable.
# RESTIC_PASSWORD=
# R2_BACKUP_BUCKET=ecity-backups

# ── Seed only. Remove before production. ─────────────────────────────────
SEED_PASSWORD=ChangeMe!2026
