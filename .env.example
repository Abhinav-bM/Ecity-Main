# Copy to .env and fill in. NEVER commit .env.
# Generate secrets with: openssl rand -base64 32

DATABASE_URL=postgres://ecity:ecity@localhost:5432/ecity
AUTH_SECRET=replace-me-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# Session policy
SESSION_IDLE_MINUTES=720
SESSION_ABSOLUTE_HOURS=336

LOG_LEVEL=info

# Branding. Swap the whole colour scheme per client without touching code.
# One of: onyx (black, default) | navy | emerald | amber
# Add new ones in src/app/globals.css + src/lib/theme.ts.
APP_THEME=onyx
# light | dark | system
APP_COLOR_SCHEME=system

# Seed only. Remove before production.
SEED_PASSWORD=ChangeMe!2026

# local = .storage/ on disk (development). s3 = Cloudflare R2 (production).
STORAGE_DRIVER=local
