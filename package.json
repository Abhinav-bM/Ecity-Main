{
  "name": "ecity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:seed": "tsx src/server/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "worker": "tsx src/server/jobs/worker.ts",
    "restart": "bash scripts/restart-app.sh",
    "docs:pdf": "bash scripts/build-docs.sh",
    "db:sync-roles": "tsx src/server/db/sync-roles.ts",
    "test:e2e:clean": "bash scripts/test-clean-db.sh",
    "prebuild": "node scripts/copy-scanner-wasm.mjs",
    "predev": "node scripts/copy-scanner-wasm.mjs",
    "perf:seed": "psql -d ${PERF_DB_NAME:-ecity_perf} -f scripts/perf-seed.sql",
    "perf:check": "PERF_DB=1 vitest run tests/integration/perf.integration.test.ts",
    "backup": "bash scripts/backup.sh",
    "restore:drill": "bash scripts/restore-drill.sh",
    "db:seed:demo": "tsx src/server/db/seed.ts --demo"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1128.0",
    "@hookform/resolvers": "^3.9.1",
    "@react-pdf/renderer": "^4.9.0",
    "barcode-detector": "^3.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.5",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "next": "^16.3.4",
    "next-themes": "^0.4.6",
    "pino": "^9.5.0",
    "postgres": "^3.4.5",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.1",
    "recharts": "^3.10.1",
    "shadcn": "^4.19.1",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.5.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.3.4",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.12.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0",
    "wait-on": "^9.1.0"
  }
}
